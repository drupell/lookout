# Lookout Dashboard environment variables.
#
# Copy to `.env.local` for local dev. Real values come from the deployed CDK
# AuthStack + ApiStack outputs:
#   aws cloudformation describe-stacks --stack-name LookoutDevAuth \
#     --query "Stacks[0].Outputs"
#   aws cloudformation describe-stacks --stack-name LookoutDevApi \
#     --query "Stacks[0].Outputs"
#
# Next.js inlines NEXT_PUBLIC_* at build time. Anything secret must NOT live here.

NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_REGION=us-east-1
NEXT_PUBLIC_COGNITO_DOMAIN=lookout-dev-auth.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_API_BASE_URL=https://abcd1234.execute-api.us-east-1.amazonaws.com/prod
