# Copy to .env and fill in your values. .env is gitignored.
# Source it before running cdk synth/deploy:
#   set -a; source .env; set +a
# Or use direnv (recommended): `direnv allow` after creating .envrc

# --- API IP allowlist (per env) ---
# Comma-separated CIDRs. Empty → no IP restriction.
# Look up your IPs:
#   curl -s -4 ifconfig.me   → IPv4
#   curl -s -6 ifconfig.me   → IPv6 (use the /64 prefix, not full /128)
#
# Example covering a /64 + IPv4 (RFC 3849 / 5737 documentation ranges):
# LOOKOUT_DEV_ALLOWED_IPS="2001:db8::/64,203.0.113.10/32"
LOOKOUT_DEV_ALLOWED_IPS=""

# Prod is open by default (Cognito + WAF only). Set to lock down.
LOOKOUT_PROD_ALLOWED_IPS=""

# --- MarketCheck (local dev / debug script only) ---
# In Lambda, the key comes from Secrets Manager. Locally, set this for
# scripts/debug_marketcheck.py and ad-hoc CLI testing.
MARKETCHECK_API_KEY=""
